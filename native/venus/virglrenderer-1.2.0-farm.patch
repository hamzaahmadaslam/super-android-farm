    return ret;
 }
 
+int vtest_resource_import_fd(UNUSED uint32_t length_dw)
+{
+   struct vtest_context *ctx = vtest_get_current_context();
+   uint32_t vcmd[VCMD_RESOURCE_IMPORT_FD_SIZE];
+   uint32_t resp_buf[VTEST_HDR_SIZE + 1];
+   struct virgl_renderer_resource_import_blob_args args;
+   struct vtest_resource *res;
+   int ret, fd;
+
+   ret = ctx->input->read(ctx->input, vcmd, sizeof(vcmd));
+   if (ret != sizeof(vcmd))
+      return -1;
+
+   fd = vtest_receive_fd(ctx->input->data.fd);
+   if (fd < 0)
+      return fd;
+
+   res = vtest_new_resource(0);
+   if (!res) {
+      close(fd);
+      return -ENOMEM;
+   }
+
+   memset(&args, 0, sizeof(args));
+   args.res_handle = res->res_id;
+   args.blob_mem = VIRGL_RENDERER_BLOB_MEM_HOST3D;
+   args.fd_type = VIRGL_RENDERER_BLOB_FD_TYPE_DMABUF;
+   args.fd = fd;
+   args.size = vcmd[VCMD_RESOURCE_IMPORT_FD_SIZE_LO] |
+               ((uint64_t)vcmd[VCMD_RESOURCE_IMPORT_FD_SIZE_HI] << 32);
+
+   ret = virgl_renderer_resource_import_blob(&args);
+   if (ret) {
+      close(fd);
+      vtest_unref_resource(res);
+      return report_failed_call("virgl_renderer_resource_import_blob", ret);
+   }
+
+   virgl_renderer_ctx_attach_resource(ctx->ctx_id, res->res_id);
+
+   resp_buf[VTEST_CMD_LEN] = 1;
+   resp_buf[VTEST_CMD_ID] = VCMD_RESOURCE_IMPORT_FD;
+   resp_buf[VTEST_CMD_DATA_START] = res->res_id;
+   ret = vtest_block_write(ctx->out_fd, resp_buf, sizeof(resp_buf));
+   if (ret < 0)
+      return ret;
+
+   util_hash_table_set(ctx->resource_table, intptr_to_pointer(res->res_id), res);
+   return 0;
+}
+
 void vtest_set_max_length(uint32_t length)
 {
    renderer.max_length = length;
