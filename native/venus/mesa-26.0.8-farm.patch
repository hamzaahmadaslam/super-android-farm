@@ -0,0 +1,60 @@
+/*
+ * farm: buffers from gralloc.venus.so carry their own layout in the handle.
+ * SPDX-License-Identifier: MIT
+ */
+#include <cutils/properties.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "farm_gralloc_handle.h"
+#include "u_gralloc_internal.h"
+#include "util/log.h"
+
+static int
+farm_get_buffer_basic_info(struct u_gralloc *gralloc,
+                           struct u_gralloc_buffer_handle *hnd,
+                           struct u_gralloc_buffer_basic_info *out)
+{
+   const struct farm_handle *fh = farm_handle_from(hnd->handle);
+   if (!fh) {
+      mesa_loge("farm gralloc: not a farm buffer handle");
+      return -EINVAL;
+   }
+   if (fh->kind != FARM_BUFFER_GPU)
+      mesa_logw("farm gralloc: CPU-only buffer (format 0x%x) handed to the GPU", fh->hal_format);
+
+   out->drm_fourcc = fh->drm_fourcc;
+   out->modifier = ((uint64_t)fh->modifier_hi << 32) | fh->modifier_lo;
+   out->num_planes = fh->num_planes;
+   for (int i = 0; i < fh->num_planes && i < 3; i++) {
+      out->fds[i] = fh->fd;
+      out->offsets[i] = fh->offsets[i];
+      out->strides[i] = fh->pitches[i];
+   }
+   return 0;
+}
+
+static int
+farm_destroy(struct u_gralloc *gralloc)
+{
+   free(gralloc);
+   return 0;
+}
+
+struct u_gralloc *
+u_gralloc_farm_create(void)
+{
+   char value[PROPERTY_VALUE_MAX] = "";
+   property_get("ro.hardware.gralloc", value, "");
+   if (strcmp(value, "venus"))
+      return NULL;
+
+   struct u_gralloc *gr = calloc(1, sizeof(*gr));
+   if (!gr)
+      return NULL;
+   gr->ops.get_buffer_basic_info = farm_get_buffer_basic_info;
+   gr->ops.destroy = farm_destroy;
+   mesa_logi("Using farm (venus) gralloc");
+   return gr;
+}
